  "scientific_protocol": {
    "train_seed": 11001,
    "validation_seed": 22002,
    "test_seed": 33003,
    "minimum_reporting_seeds": 10,
    "selection_metric": "validation_success_then_spl_then_steps",
    "forbid_test_set_tuning": true,
    "report_confidence_intervals": true
  },
  "evaluation": {
    "eval_episodes": 200,
    "out_dir": "runs/Office_Building/evaluation/results/qlearning",
    "plots_dir": "runs/Office_Building/evaluation/plots/qlearning"
  },
  "visualization": {
    "q_dir": "runs/Office_Building/models/qlearning",
